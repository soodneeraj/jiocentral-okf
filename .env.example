# Copy to .env and fill in real values. Never commit .env.

# Milvus vector DB (docker port 19530)
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=

# Ollama — Google Gemma 4 for chat/vision (local)
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=gemma4:12b
CHAT_MODEL_FALLBACK=qwen2.5-coder:14b
VISION_MODEL=gemma4:12b
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=768

# Elasticsearch Q&A cache (docker port 9200, typically HTTPS)
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CACHE_INDEX=okf_qa_cache
ELASTICSEARCH_CACHE_TTL_SECONDS=3600
ELASTICSEARCH_CACHE_ENABLED=true

TEXT_COLLECTION=jcrag_text_chunks
IMAGE_COLLECTION=jcrag_image_chunks
TOP_K=5
CHAT_NUM_CTX=4096
CHAT_NUM_PREDICT=512

DATABASE_PATH=data/okf_metadata.db
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
ADMIN_API_KEY=
OCR_ENABLED=true
ENABLE_IMAGE_SEARCH=true
ANSWER_VLM_ENABLED=false
DOCUMENT_FAITHFUL_ANSWERS=true
FAITHFUL_PAGE_WINDOW=0
FAITHFUL_MAX_PAGES=1
FAITHFUL_CONTINUATION_PAGES=1
FAITHFUL_MAX_IMAGES=6
HEADER_FOOTER_FILTER_ENABLED=true
HEADER_FOOTER_MIN_PAGES=2
DROP_DUPLICATE_IMAGES=true
DELETE_DUPLICATE_IMAGE_FILES=true
INDEX_HEADER_FOOTER_IMAGES=false
LOW_INFO_FILTER_ENABLED=true
LOW_INFO_MAX_STD=5.0
SKIP_BLANK_PAGE_RENDERS=true
QUERY_MODE_DETECTION=true
ANSWER_ACTIONS_ENABLED=true
AMBIGUITY_SCORE_GAP_THRESHOLD=0.03
